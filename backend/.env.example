# Copy to .env and fill in. Never commit .env.
# In production these are set in the Render dashboard (Environment), not in files.
NODE_ENV=development
PORT=4000
# Use "memory" to run an in-memory MongoDB for local dev (no Docker needed).
MONGODB_URI=memory
# Or a real database, e.g. mongodb://localhost:27017/mesh (docker compose up mongo) or a MongoDB Atlas URI.
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CORS_ORIGIN=http://localhost:5173
# "fake" (deterministic, no API calls) or "sarvam"
LLM_PROVIDER=fake
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
# Optional latency knobs (docs/DECISIONS.md §17). Empty = API default.
# none | low | medium | high | max
SARVAM_REASONING_EFFORT=
# e.g. sarvam-105b-conversations (non-reasoning) for the classifier step only
SARVAM_CLASSIFY_MODEL=
# Optional: your actual price per 1K tokens in INR, used for eval cost. Leave empty to report tokens only.
LLM_COST_PER_1K_TOKENS_INR=
# Refunds up to this amount can be approved by an agent; above it the ticket escalates.
REFUND_AGENT_LIMIT_INR=2000
